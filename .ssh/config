Include vagrant.d/sshconfig
Include labs.d/*
Host clarian-provision
   HostName 10.50.153.1
   #   HostName 10.50.150.46
   User mavieira
   Port 22
   ForwardAgent yes
   IdentityFile "${HOME}/.ssh/new_windows.pem"
Host *
   LogLevel VERBOSE
   ForwardAgent yes
   # ForwardX11 yes
   ForwardX11Trusted yes
   PasswordAuthentication yes
#    BatchMode no
   CheckHostIP yes
   AddressFamily any
#   ConnectTimeout 0
   StrictHostKeyChecking no
   UserKnownHostsFile /dev/null
   Preferredauthentications publickey,password
   Port 22
   Protocol 2
   PermitLocalCommand yes
   ServerAliveInterval 15
   SendEnv LANG LC_*

